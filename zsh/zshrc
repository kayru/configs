CONFIGS_DIR="${${(%):-%x}:A:h:h}"

ZSH=$HOME/.oh-my-zsh
ZSH_THEME="af-magic"
zstyle ':omz:update' mode auto

# Must precede oh-my-zsh: its brew plugin picks up Intel brew in /usr/local otherwise
if [[ "$OSTYPE" == darwin* && -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Debian/Ubuntu package fd as fdfind
if (( $+commands[fd] )); then
  _fd=fd
elif (( $+commands[fdfind] )); then
  _fd=fdfind
  alias fd=fdfind
fi
if [[ -n "$_fd" ]]; then
  export FZF_DEFAULT_COMMAND="$_fd --type f --hidden --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="$_fd --type d --hidden --exclude .git"
fi
unset _fd

plugins=(git brew extract virtualenv rust zsh-completions sudo colored-man-pages zsh-autosuggestions)
if [[ "$OSTYPE" == darwin* ]]; then
  plugins+=(macos)
fi
# Both plugins complain on every start when their binary is missing. Pre-0.48 fzf (Ubuntu 22.04)
# has no --zsh and relies on /usr/share/doc, which minimized Ubuntu installs strip.
if (( $+commands[fzf] )) && { fzf --zsh > /dev/null 2>&1 || [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] }; then
  plugins+=(fzf)
fi
if (( $+commands[zoxide] )); then
  plugins+=(zoxide)
fi
# syntax-highlighting wraps widgets defined before it; substring-search must come after it
plugins+=(zsh-syntax-highlighting history-substring-search)

source $ZSH/oh-my-zsh.sh

# Over SSH, tint af-magic's separator line and user@host with a per-host colour. Derived from the
# hostname so no hostnames live in this public repo; a machine can set CONFIGS_HOST_COLOR=<0-255>
# in its ~/.zshrc before sourcing this file. Must match bash/kayru_common.sh.
if [[ -n "$SSH_CONNECTION" && "$ZSH_THEME" == af-magic ]]; then
  if [[ -z "$CONFIGS_HOST_COLOR" ]]; then
    _palette=(167 173 179 107 73 110 140 175)
    _crc="$(printf %s "${HOST%%.*}" | cksum)"
    CONFIGS_HOST_COLOR=${_palette[$(( ${_crc%% *} % ${#_palette} + 1 ))]}
    unset _palette _crc
  fi
  # Not ${FG[n]}: its keys are zero-padded ("073")
  _host_fg="%{"$'\e'"[38;5;${CONFIGS_HOST_COLOR}m%}"
  PS1="${PS1/"${FG[237]}"/$_host_fg}"
  RPS1="${RPS1/"${FG[237]}%n@%m"/%B$_host_fg%n@%m%b}"
  unset _host_fg
fi

PATH=~/bin:$PATH
export PATH

source "$CONFIGS_DIR/bash/dir_colors.sh"

if (( $+commands[gls] )); then
  alias ls='gls --color=auto'
elif [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -G'
else
  alias ls='ls --color=auto'
fi
alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alhF'

source "$CONFIGS_DIR/zsh/plugins/cmake-workflow/cmake-workflow.plugin.zsh"
