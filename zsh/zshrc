ZSH=$HOME/.oh-my-zsh
ZSH_THEME="af-magic"

plugins=(git macos brew extract virtualenv rust zsh-completions)

source $ZSH/oh-my-zsh.sh

PATH=~/bin:/usr/local/bin:$PATH
export PATH

source ~/configs/bash/dir_colors.sh

alias ls='gls --color=auto'
alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alhF'

DISABLE_UPDATE_PROMPT=true

autoload -U compinit && compinit
